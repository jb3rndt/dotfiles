#!/usr/bin/env zsh

# Usage: yeeta
if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "Not a git repository (or no .git directory found)."
  exit 1
fi

if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
  echo "No commits yet. Create an initial commit first."
  exit 2
fi

git add -A

staged=$(git diff --cached --name-only || true)
if [ -z "$staged" ]; then
  echo "No changes to amend."
  exit 0
fi

echo "Changes:"
git --no-pager diff --stat --cached
echo
printf "Amend last commit and push? [Enter/n] "
IFS= read -r confirm
echo
confirm=${confirm:-y}
if ! [[ "$confirm" =~ ^[Yy] ]]; then
  echo "Aborted."
  exit 5
fi

if ! git commit --amend --no-edit; then
  echo "Amend failed." >&2
  exit 4
fi

if ! git push --force-with-lease; then
  echo "Push failed." >&2
  exit 3
fi

echo "Pushed."
exit 0
